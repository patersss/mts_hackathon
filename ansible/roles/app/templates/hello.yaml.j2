apiVersion: v1
kind: Namespace
metadata:
  name: {{ app_namespace }}
  labels:
    pod-security.kubernetes.io/enforce: restricted
{% for version in ['v1', 'v2'] %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: hello-{{ version }}
  namespace: {{ app_namespace }}
data:
  nginx.conf: |
    worker_processes 1;
    pid /tmp/nginx.pid;
    events { worker_connections 1024; }
    http {
      client_body_temp_path /tmp/client_temp;
      proxy_temp_path /tmp/proxy_temp;
      fastcgi_temp_path /tmp/fastcgi_temp;
      uwsgi_temp_path /tmp/uwsgi_temp;
      scgi_temp_path /tmp/scgi_temp;
      server_tokens off;

      log_format json escape=json '{"time":"$time_iso8601","remote_addr":"$remote_addr",'
        '"x_forwarded_for":"$http_x_forwarded_for","host":"$host","method":"$request_method",'
        '"uri":"$request_uri","status":$status,"bytes":$body_bytes_sent,'
        '"request_time":$request_time,"user_agent":"$http_user_agent","version":"{{ version }}"}';
      access_log /dev/stdout json;
      error_log /dev/stderr warn;

      server {
        listen 8080;
        default_type text/plain;
        add_header X-App-Version {{ version }} always;
        location / {
          return 200 "Hello World!\n";
        }
        location = /healthz {
          access_log off;
          return 200 "ok\n";
        }
      }

      server {
        listen 127.0.0.1:8081;
        access_log off;
        location = /stub_status {
          stub_status;
        }
      }
    }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: hello-{{ version }}
  namespace: {{ app_namespace }}
spec:
  replicas: {{ 2 if version == 'v1' else 1 }}
  selector:
    matchLabels:
      app: hello
      version: {{ version }}
  template:
    metadata:
      labels:
        app: hello
        version: {{ version }}
      annotations:
        kubectl.kubernetes.io/default-container: nginx
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: nginx
          image: {{ nginx_image }}
          ports:
            - name: http
              containerPort: 8080
          readinessProbe:
            httpGet: {path: /healthz, port: http}
          livenessProbe:
            httpGet: {path: /healthz, port: http}
          resources:
            requests: {cpu: 10m, memory: 16Mi}
            limits: {cpu: 200m, memory: 64Mi}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          volumeMounts:
            - {name: config, mountPath: /etc/nginx/nginx.conf, subPath: nginx.conf}
            - {name: tmp, mountPath: /tmp}
        - name: exporter
          image: {{ nginx_exporter_image }}
          args: [--nginx.scrape-uri=http://127.0.0.1:8081/stub_status]
          ports:
            - name: metrics
              containerPort: 9113
          resources:
            requests: {cpu: 5m, memory: 16Mi}
            limits: {cpu: 100m, memory: 32Mi}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
      volumes:
        - name: config
          configMap:
            name: hello-{{ version }}
        - name: tmp
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: hello-{{ version }}
  namespace: {{ app_namespace }}
spec:
  selector:
    app: hello
    version: {{ version }}
  ports:
    - name: http
      port: 80
      targetPort: http
{% endfor %}
---
apiVersion: v1
kind: Service
metadata:
  name: hello
  namespace: {{ app_namespace }}
spec:
  selector:
    app: hello
  ports:
    - name: http
      port: 80
      targetPort: http
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: hello
  namespace: {{ app_namespace }}
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app: hello
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: hello
  namespace: {{ app_namespace }}
spec:
  parentRefs:
    - name: public
      namespace: gateway
  rules:
{% set common %}
      timeouts: {request: 10s, backendRequest: 5s}
      filters:
        - type: ResponseHeaderModifier
          responseHeaderModifier:
            set:
              - {name: X-Served-By, value: envoy-gateway}
              # Envoy подставляет id, который сам сгенерировал для запроса
              - {name: X-Request-ID, value: "%REQ(X-REQUEST-ID)%"}
{% endset %}
    - name: v1
      matches:
        - path: {type: PathPrefix, value: /v1}
      backendRefs:
        - {name: hello-v1, port: 80}
{{ common }}
    - name: v2
      matches:
        - path: {type: PathPrefix, value: /v2}
      backendRefs:
        - {name: hello-v2, port: 80}
{{ common }}
    - name: by-header
      matches:
        - headers:
            - {name: X-Version, value: v2}
      backendRefs:
        - {name: hello-v2, port: 80}
{{ common }}
    - name: split
      backendRefs:
        - {name: hello-v1, port: 80, weight: 80}
        - {name: hello-v2, port: 80, weight: 20}
{{ common }}
---
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: BackendTrafficPolicy
metadata:
  name: hello-v2-ratelimit
  namespace: {{ app_namespace }}
spec:
  targetRefs:
    - group: gateway.networking.k8s.io
      kind: HTTPRoute
      name: hello
      sectionName: v2
  rateLimit:
    type: Local
    local:
      rules:
        - limit: {requests: 10, unit: Second}
---
apiVersion: monitoring.coreos.com/v1
kind: PodMonitor
metadata:
  name: hello
  namespace: {{ app_namespace }}
spec:
  podTargetLabels: [version]
  selector:
    matchLabels:
      app: hello
  podMetricsEndpoints:
    - port: metrics
---
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: hello
  namespace: {{ app_namespace }}
spec:
  groups:
    - name: hello
      rules:
        - alert: HelloDown
          expr: sum(nginx_up{namespace="{{ app_namespace }}"}) == 0 or absent(nginx_up{namespace="{{ app_namespace }}"})
          for: 2m
          labels: {severity: critical}
          annotations:
            summary: Нет живых подов hello
        - alert: Hello5xx
          expr: sum(rate(envoy_cluster_upstream_rq_xx{envoy_response_code_class="5", envoy_cluster_name=~"httproute/{{ app_namespace }}/hello/.*"}[5m])) > 0.1
          for: 5m
          labels: {severity: warning}
          annotations:
            summary: Ответы 5xx от hello через Gateway
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: default-deny
  namespace: {{ app_namespace }}
spec:
  podSelector: {}
  policyTypes: [Ingress, Egress]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: hello
  namespace: {{ app_namespace }}
spec:
  podSelector:
    matchLabels:
      app: hello
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: envoy-gateway-system
        # kubelet probes
        - ipBlock:
            cidr: {{ node_ip }}/32
      ports:
        - port: http
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: monitoring
      ports:
        - port: metrics
